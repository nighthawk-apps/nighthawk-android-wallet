syntax: glob
.DS_Store
.gradle/
.idea/
.idea/caches
.idea/compiler.xml
.idea/dictionaries/
.idea/gradle.xml
.idea/libraries/
.idea/modules.xml
.idea/tasks.xml
.idea/workspace.xml
.settings
*.iml
bin/
build/
gen/
local.properties
/.idea/deploymentTargetDropDown.xml
*.hprof
/.idea/artifacts
/.idea/assetWizardSettings.xml
/.idea/inspectionProfiles/Project_Default.xml
/.idea/androidTestResultsUserPreferences.xml
google-services.json

# Rust / Cargo (local UniFFI builds)
rust/**/target/
.cargo-home/

# UniFFI Android libs — build with cargo-ndk locally or in CI; not versioned (see README “Build the project”)
darkfi-android-sdk/src/main/jniLibs/**/libdarkfi_mobile_ffi.so

# Scratch downloads from scripts/fetch-darkfi-upstream-reference.sh (pinned upstream blobs)
docs/upstream/_scratch/

# Vendored DarkFi workspace (scripts/vendor-darkfi.sh)
third_party/darkfi/

# Prebuilt DarkIRC binaries for APK (produce via scripts/build-darkirc-android.sh or CI — see artifacts/darkirc/README.md)
artifacts/darkirc/*/darkirc_exec

# Prebuilt UniFFI wallet FFI (produce via scripts/build-darkfi-mobile-ffi-android.sh)
artifacts/mobile-ffi/**/libdarkfi_mobile_ffi.so


# Android native (CMake) intermediates
.cxx/
.externalNativeBuild/

# Local profiling / captures (Android Studio)
captures/

# Logs & swap files
*.log
*.swp
*~

# Windows junk
Thumbs.db
Desktop.ini

# Generated lint dumps sometimes copied into tree roots
lint-results*.xml

/.idea/kotlinc.xml

# Compiled shared libraries
*.so

# Build directories
.build/
.cargo_home/
