<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallet key material must never leave the device via cloud backup or
  device-to-device transfer. allowBackup="false" covers legacy backup;
  these rules make the intent explicit on Android 12+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
