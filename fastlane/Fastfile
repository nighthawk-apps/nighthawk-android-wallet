# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:android)

platform :android do

  # ── F-Droid ────────────────────────────────────────────────────────────
  #
  # The recipe runs scripts/build-darkfi-mobile-ffi-android.sh with
  # FDROID_BUILD=1, then assembleDarkfitestnetRelease. That APK is unsigned.
  # F-Droid publishes a reproducible build only when that unsigned APK matches
  # the file at Binaries (signature excluded). We sign the buildserver APK
  # with the testnet upload key and publish that file; F-Droid does not
  # create its own signing key for this app.
  #
  # Native libdarkfi_mobile_ffi.so must already be built. Local:
  #   export FDROID_BUILD=1 ANDROID_NDK_HOME="$ANDROID_SDK_ROOT/ndk/26.1.10909125"
  #   rustup default 1.94.0
  #   ./scripts/build-darkfi-mobile-ffi-android.sh

  desc "Build unsigned DarkFi testnet release APK for F-Droid"
  lane :fdroid do
    # Matches package com.nighthawkwallet.android.testnet / flavor darkfitestnet.
    gradle(
      task: "clean assembleDarkfitestnetRelease",
      properties: {
        # Leave the APK unsigned. Signing happens after the buildserver
        # output is the one we publish.
        "IS_SIGN_RELEASE_BUILD_WITH_DEBUG_KEY" => "false",
      }
    )
    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    UI.success("F-Droid APK: #{apk_path}") if apk_path
  end

  desc "Run unit tests"
  lane :test do
    gradle(task: "testDarkfimainnetReleaseUnitTest")
  end

  # ── Internal distribution ──────────────────────────────────────────────

  desc "Submit Build to AppCenter"
  lane :build do |options|
    gradle(task: "clean assembleDarkfimainnetRelease")
    upload_to_app_center(
      api_token: options[:api_token],
      app_name: options[:app_name],
      notes: "Author: #{last_git_commit[:author]}, changes: #{last_git_commit[:message]}"
    )
  end

  private_lane :upload_to_app_center do |options|
    appcenter_upload(
      api_token: options[:api_token],
      app_name: options[:app_name],
      owner_name: "Nighthawk-Apps",
      owner_type: "organization",
      release_notes: options[:notes],
      notify_testers: true
    )
  end

end
