     and should map directly to the design style guide -->

    <color name="nh_white">#F5F5F5</color>
    <color name="nh_gray">#616161</color>
    <color name="nh_white_12">#1FFFFFFF</color>
    <color name="nh_white_24">#3DFFFFFF</color>
    <color name="nh_white_40">#66FFFFFF</color>
    <color name="nh_white_50">#80FFFFFF</color>
