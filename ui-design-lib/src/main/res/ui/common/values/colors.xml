    <color name="nh_white_87">#BFFFFFFF</color>
    <color name="nh_white_light">@color/ns_peach_20</color>
    <color name="nh_black_light">#2B2B2B</color>
    <color name="nh_black_12">#1F000000</color>
    <color name="nh_black_40">#66000000</color>
    <color name="nh_black_54">#8A000000</color>
