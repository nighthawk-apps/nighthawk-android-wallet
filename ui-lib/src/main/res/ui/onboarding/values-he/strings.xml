    <string name="onboarding_1_header">ברוכים הבאים!</string>
    <string name="onboarding_1_body">DarkFi מסדרת העברות באופן פרטי כברירת מחדל. הארנק הזה מציג יתרת DRK אחת מנקודת הסנכרון שלך — לא סכומים נפרדים שקופים ומוגנים.\n\nבחרו שרתים שאתם סומכים עליהם וגבו את ביטוי השחזור.</string>
    <string name="onboarding_1_image_content_description"></string>
    <string name="onboarding_2_header">פורמטי קבלה</string>
    <string name="onboarding_2_body">אפשר לשתף קידודי קבלה שונים (מחרוזת הפקדה, QR, קודים אופציונליים בסגנון ציבורי). לאחר חיבור הסנכרון הם זוכים לאותו ארנק DarkFi.\n\nהשתמשו בפורמט שהמשלם מצפה לו.</string>
    <string name="onboarding_2_image_content_description"></string>
    <string name="onboarding_3_header">ועוד הרבה יותר…</string>
    <string name="onboarding_3_body">אנחנו ממשיכים לשפר סנכרון מהיר יותר וכלים ברורים יותר סביב DarkFi ו־DRK.\n\nצפו לשיפורים מתמשכים.</string>
    <string name="onboarding_3_image_content_description"></string>
    <string name="onboarding_4_header">בואו נתחיל!</string>
    <string name="onboarding_4_body">בחרו בין יצירת ארנק חדש לבין ייבוא ביטוי שחזור סודי קיים.</string>
    <string name="onboarding_4_image_content_description"></string>
