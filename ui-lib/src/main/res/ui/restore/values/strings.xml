    <string name="ns_tor_network_settings_row_title">Tor network (privacy)</string>
    <string name="ns_tor_network_settings_row_desc">Route wallet HTTP via Tor SOCKS; chat uses the same relay</string>
    <string name="ns_tor_network_screen_title">Tor network</string>
    <string name="ns_tor_network_screen_body">Tor is off by default — the app uses your normal mobile network (clearnet). Turn on app-wide Tor routing only if you want wallet HTTP and DarkIRC P2P to use SOCKS (default loopback 127.0.0.1:9050). You can use built-in tor-android or an external SOCKS proxy.</string>
    <string name="ns_tor_network_section_routing">App-wide Tor routing</string>
    <string name="ns_tor_network_section_routing_desc">Routes wallet HTTPS, embedded darkfid/darkirc P2P (onion seeds), and remote IRC hosts through SOCKS. Loopback embedded DarkIRC IRC stays direct.</string>
    <string name="ns_tor_network_wallet_toggle">Route wallet + chat P2P through Tor SOCKS</string>
    <string name="ns_tor_network_section_builtin">Built-in Tor (tor-android)</string>
    <string name="ns_tor_network_section_builtin_desc">Runs Guardian tor-android inside the app and exposes a loopback SOCKS listener. This is separate from an external Tor/SOCKS app you configure below.</string>
    <string name="ns_tor_network_embedded_tor">Use built-in tor-android</string>
    <string name="ns_tor_network_embedded_tor_desc">When on, the app starts Tor and listens on the SOCKS host/port below. When off, only an external SOCKS proxy is used.</string>
    <string name="ns_tor_network_embedded_tor_requires_routing">Enable app-wide Tor routing above to use built-in Tor.</string>
    <string name="ns_tor_network_section_socks">SOCKS endpoint</string>
    <string name="ns_tor_network_section_socks_desc_embedded">Loopback address where built-in tor-android listens (default 127.0.0.1:9050). Embedded DarkIRC uses this proxy for .onion P2P seeds.</string>
    <string name="ns_tor_network_section_socks_desc_external">Host and port of your external Tor or SOCKS proxy. Required when built-in Tor is off.</string>
    <string name="ns_tor_network_footer_note">Changing built-in Tor or SOCKS restarts embedded DarkIRC when enabled so P2P/event-graph transport matches. Open Chat to verify green status lights.</string>
    <string name="ns_tor_network_done">Done</string>

